# ============================================================
# WL AI Director — 环境配置模板
# 复制为 .env 并按需修改: cp .env.example .env
# ============================================================

# ---------- 前端配置 ----------
# PocketBase 服务地址（构建时注入前端，修改后需重新构建）
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# ---------- PocketBase 管理员 ----------
# 首次启动时自动创建，已有则忽略
PB_ADMIN_EMAIL=admin@wlai.com
PB_ADMIN_PASSWORD=admin123456
